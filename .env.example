# Copy to .env.local (development) or set in your hosting provider (production).
# NEVER commit real values. Only the two NEXT_PUBLIC_* variables reach the browser.

# --- Database (Supabase Postgres) -------------------------------------------------
# Local (supabase start): postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Production: use the *transaction pooler* URL (port 6543) for DATABASE_URL and add
# ?pgbouncer=true ; use the direct connection (port 5432) for DIRECT_URL (migrations).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# --- Supabase Auth ----------------------------------------------------------------
# Local values are printed by `npx supabase status`. The anon/publishable key is public by design;
# the database has RLS and no table is readable with it (see prisma/migrations/*_rls).
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon key from supabase status>"

# Only for `npm run db:seed` (local Supabase only; the script refuses anything else). SECRET.
SUPABASE_SERVICE_ROLE_KEY=""

# --- App --------------------------------------------------------------------------
# Public base URL (links in invitations, hosted forms, sitemap). No trailing slash.
APP_URL="http://localhost:3010"

# --- WhatsApp (see docs/WHATSAPP.md) ----------------------------------------------
# "mock" (default, no real messages) or "cloud" (Meta WhatsApp Cloud API)
WHATSAPP_PROVIDER="mock"
# Random long string; must match the verify token configured in Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN="change-me"
# Meta app secret: used to validate X-Hub-Signature-256 on every webhook. SECRET.
WHATSAPP_APP_SECRET="change-me"
# Only when WHATSAPP_PROVIDER=cloud. SECRET (permanent System User token).
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_API_VERSION="v23.0"

# --- AI assistant (plan Élite) --------------------------------------------------------
# Anthropic API key (console.anthropic.com). SECRET. Without it the AI buttons show a friendly error.
ANTHROPIC_API_KEY=""
# Optional. Defaults to claude-opus-5-5. A cheaper model (e.g. claude-haiku-5-5) lowers cost per query.
AI_MODEL=""

# --- Email notifications (invitations, new-lead alerts, daily digest) -----------------
# "mock" (default: nothing is sent), "mailpit" (local dev: Supabase's Mailpit at MAILPIT_URL)
# or "resend" (production: https://resend.com, needs a verified sending domain).
EMAIL_PROVIDER=mock
EMAIL_FROM="Pórtico <hola@portico.mx>"
RESEND_API_KEY=
MAILPIT_URL=http://127.0.0.1:54324
# Protects GET /api/cron/daily-digest (send "Authorization: Bearer <CRON_SECRET>", at least 16 chars).
# Without it the endpoint rejects every call. Schedule it once a day.
CRON_SECRET=

# --- Public lead form hardening ---------------------------------------------------
# How to read the visitor IP: "vercel", "cloudflare" or "xff:N" (N trusted proxies). Unset = do not
# trust any forwarded header (no per-IP limit; per-org and per-phone limits still apply).
TRUSTED_PROXY=
# Signs the anti-bot timestamp of the hosted form. Random, 32+ chars. SECRET.
FORM_TOKEN_SECRET=

# --- Tests --------------------------------------------------------------------------
# `npm test` uses its own database, "<name>_test" on the same server (created, migrated and EMPTIED
# automatically). Set this only to use another one; it must be named *_test because it gets truncated.
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/inmobiliaria_test
